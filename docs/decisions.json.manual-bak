[
  {
    "filename": "1004_14.05.2025",
    "date": "14.05.2025",
    "decision_num": "1004/3дп/15-25",
    "url": "https://hcj.gov.ua/doc/doc/52389",
    "judge_name": "Бочаров Андрій Іванович",
    "court": "Овідіопольський районний суд Одеської області",
    "chamber": "Третя",
    "art106_grounds": [
      "п.2 ч.1 ст.106"
    ],
    "qualification": {
      "complaint": "Скаржниця кваліфікувала діяння за підпунктами «а», «г» пункту 1, пунктами 2, 3, 4 частини першої статті 106 (порушення процесуального права, нерівність сторін, затягування розгляду, поведінка, що порочить звання судді, грубе порушення закону).",
      "dp": "Пункт 2 частини першої статті 106 — безпідставне затягування / невжиття заходів щодо розгляду справи № 509/5547/20 протягом установленого законом строку.",
      "vrp": null
    },
    "conduct": {
      "complaint": "За доводами скаржниці суддя безпідставно відмовляв у клопотаннях про долучення/витребування доказів і призначення експертизи, неправильно застосував право, а розгляд справи затягнув майже на чотири роки, призначаючи засідання з інтервалом 2–3 місяці.",
      "dp": "Палата встановила, що суддя допустив безпідставне затягування розгляду цивільної справи: підготовче провадження тривало понад три роки, справа перебувала у провадженні близько чотирьох років.",
      "vrp": null
    },
    "sanction": {
      "dp": "Попередження.",
      "vrp": null
    },
    "summary": {
      "essence": "Третя Дисциплінарна палата притягнула суддю Овідіопольського районного суду Одеської області Бочарова А.І. до дисциплінарної відповідальності за безпідставне затягування розгляду справи (п.2 ч.1 ст.106) та застосувала стягнення у виді попередження.",
      "facts": "За скаргою Ступіної С.Ф. палата розглянула дії судді у справі № 509/5547/20. Підготовче провадження у справі тривало понад три роки, а сама справа перебувала у провадженні судді близько чотирьох років. Палата кваліфікувала діяння лише за п.2 ч.1 ст.106. Раніше застосоване до судді попередження (рішення від 10 липня 2020 року) визнано погашеним. З урахуванням характеру проступку, позитивної характеристики та відсутності непогашених стягнень обрано попередження.",
      "conclusions": [
        "Тривалість підготовчого провадження понад три роки свідчить про безпідставне затягування розгляду справи.",
        "Діяння кваліфіковано за п.2 ч.1 ст.106 Закону «Про судоустрій і статус суддів».",
        "Раніше застосоване попередження є погашеним, тому відсутні підстави для більш суворого стягнення.",
        "Пропорційним проступку визнано попередження."
      ]
    },
    "processed_at": "2026-06-07 15:49:37"
  },
  {
    "filename": "1015_14.05.2025",
    "date": "14.05.2025",
    "decision_num": "1015/2дп/15-25",
    "url": "https://hcj.gov.ua/doc/doc/52514",
    "judge_name": "Шишкін Олексій Володимирович",
    "court": "Шевченківський районний суд міста Харкова (на час дій — Дзержинський)",
    "chamber": "Друга",
    "art106_grounds": [
      "пп. «а» п.1 ч.1 ст.106",
      "п.2 ч.1 ст.106"
    ],
    "qualification": {
      "complaint": "Скаржниця кваліфікувала діяння за підпунктами «а», «г» пункту 1, пунктами 2, 4 частини першої статті 106.",
      "dp": "Підпункт «а» пункту 1 та пункт 2 частини першої статті 106 — істотне порушення норм процесуального права (незаконна відмова в доступі до правосуддя) та невжиття заходів щодо розгляду заяви у строк.",
      "vrp": null
    },
    "conduct": {
      "complaint": "За доводами скаржниці суддя тривалий час не вживав дій щодо розгляду позову, а потім безпідставно повернув позовну заяву під приводом зловживання процесуальними правами, порушив строки, обмежив доступ до правосуддя й несвоєчасно вніс рішення до ЄДРСР.",
      "dp": "Палата встановила очевидну недбалість в організації розгляду питання допустимості позовної заяви та неодноразове безпідставне створення перешкод під штучним приводом зловживання правами, що призвело до втрати особою можливості судового захисту і стало однією з причин її банкрутства.",
      "vrp": null
    },
    "sanction": {
      "dp": "Сувора догана — з позбавленням права на отримання доплат до посадового окладу судді протягом трьох місяців (з огляду на непогашені стягнення).",
      "vrp": null
    },
    "summary": {
      "essence": "Друга Дисциплінарна палата притягнула суддю Шишкіна О.В. до дисциплінарної відповідальності за незаконну відмову в доступі до правосуддя та невжиття заходів щодо розгляду заяви (пп. «а» п.1, п.2 ч.1 ст.106) і застосувала сувору догану з позбавленням доплат на три місяці.",
      "facts": "За скаргою Федоренко С.О. палата встановила, що суддя тривалий час не розглядав позов, а 8 лютого 2021 року безпідставно повернув позовну заяву, мотивуючи це зловживанням процесуальними правами; ухвалу скасовано апеляційним судом. Бездіяльність та безпідставне створення перешкод призвели до втрати особою можливості судового захисту і сприяли її банкрутству. З огляду на наявність непогашених дисциплінарних стягнень застосовано більш суворе стягнення.",
      "conclusions": [
        "Безпідставне повернення позовної заяви під приводом зловживання правами є незаконною відмовою в доступі до правосуддя.",
        "Недбалість в організації розгляду призвела до втрати особою права на судовий захист.",
        "Діяння кваліфіковано за пп. «а» п.1 та п.2 ч.1 ст.106.",
        "За наявності непогашених стягнень застосовано більш суворе стягнення — сувору догану."
      ]
    },
    "processed_at": "2026-06-07 15:49:37"
  },
  {
    "filename": "1016_14.05.2025",
    "date": "14.05.2025",
    "decision_num": "1016/2дп/15-25",
    "url": "https://hcj.gov.ua/doc/doc/52631",
    "judge_name": "Авраменко Андрій Миколайович",
    "court": "Амур-Нижньодніпровський районний суд міста Дніпра",
    "chamber": "Друга",
    "art106_grounds": [
      "п.2 ч.1 ст.106"
    ],
    "qualification": {
      "complaint": "Пункт 2 частини першої статті 106 — несвоєчасне надання копії судового рішення для внесення до ЄДРСР.",
      "dp": "Пункт 2 частини першої статті 106 — зволікання з виготовленням повного тексту рішення та несвоєчасне внесення його до ЄДРСР.",
      "vrp": null
    },
    "conduct": {
      "complaint": "За доводами скаржника повний текст рішення у справі № 199/9947/21 надіслано до ЄДРСР 1 січня 2024 року — майже через рік після оголошення вступної та резолютивної частин.",
      "dp": "Палата встановила несвоєчасне виготовлення та надання повного тексту судового рішення (зволікання близько року); проступок мав неумисний характер.",
      "vrp": null
    },
    "sanction": {
      "dp": "Попередження.",
      "vrp": null
    },
    "summary": {
      "essence": "Друга Дисциплінарна палата притягнула суддю Авраменка А.М. до дисциплінарної відповідальності за зволікання з виготовленням повного тексту рішення (п.2 ч.1 ст.106) та застосувала попередження.",
      "facts": "За скаргою Дніпровської міської ради палата встановила, що у справі № 199/9947/21 вступну та резолютивну частини рішення проголошено 3 лютого 2023 року, а повний текст внесено до ЄДРСР лише 1 січня 2024 року — майже через рік. Скаржник неодноразово звертався із заявами про отримання повного тексту. Палата визнала проступок неумисним, урахувала позитивну характеристику та відсутність інших стягнень.",
      "conclusions": [
        "Затримка виготовлення повного тексту рішення майже на рік становить дисциплінарний проступок за п.2 ч.1 ст.106.",
        "Проступок мав неумисний характер.",
        "З урахуванням позитивної характеристики обрано попередження як пропорційне стягнення."
      ]
    },
    "processed_at": "2026-06-07 15:49:37"
  },
  {
    "filename": "1082_21.05.2025",
    "date": "21.05.2025",
    "decision_num": "1082/3дп/15-25",
    "url": "https://hcj.gov.ua/doc/doc/52823",
    "judge_name": "Тополева Юлія Володимирівна",
    "court": "Хаджибейський районний суд міста Одеси (раніше — Малиновський)",
    "chamber": "Третя",
    "art106_grounds": [
      "пп. «а» п.1 ч.1 ст.106",
      "п.4 ч.1 ст.106"
    ],
    "qualification": {
      "complaint": "Скаржник кваліфікував діяння як істотне порушення норм процесуального права під час постановлення ухвали про забезпечення позову.",
      "dp": "Істотне порушення норм процесуального права (умисне), пов'язане з постановленням ухвали про забезпечення позову, якою фактично зупинено виконання рішення суду в іншій справі (пп. «а» п.1, п.4 ч.1 ст.106).",
      "vrp": null
    },
    "conduct": {
      "complaint": "За скаргою Дубового С.А. суддя ухвалою про забезпечення позову зупинила стягнення та реалізацію майна і наклала арешт у виконавчому провадженні, фактично зупинивши виконання рішення суду в іншій справі.",
      "dp": "Палата встановила, що суддя діяла з прямим умислом: усвідомлювала, що зупиняє дію та виконання рішення суду в іншій справі, проте врахувала як пом'якшувальну обставину ймовірно недобросовісні дії інших осіб.",
      "vrp": null
    },
    "sanction": {
      "dp": "Попередження.",
      "vrp": null
    },
    "summary": {
      "essence": "Третя Дисциплінарна палата притягнула суддю Тополеву Ю.В. до дисциплінарної відповідальності за умисне істотне порушення процесуального права при забезпеченні позову та застосувала попередження.",
      "facts": "За скаргою Дубового С.А. палата встановила, що ухвалою від 28 жовтня 2021 року у справі № 521/17134/21 суддя задовольнила заяву про забезпечення позову, зупинила стягнення і реалізацію майна та наклала арешт, фактично зупинивши виконання рішення суду в іншій справі (№ 509/1379/20). Палата дійшла висновку про прямий умисел судді, але врахувала ймовірно недобросовісні дії інших осіб як пом'якшувальну обставину та обрала найм'якше стягнення.",
      "conclusions": [
        "Ухвала про забезпечення позову фактично зупинила виконання рішення суду в іншій справі.",
        "Вина судді характеризується прямим умислом.",
        "Як пом'якшувальну обставину враховано ймовірно недобросовісні дії інших осіб.",
        "Достатнім і пропорційним визнано попередження."
      ]
    },
    "processed_at": "2026-06-07 15:49:37"
  },
  {
    "filename": "1083_21.05.2025",
    "date": "21.05.2025",
    "decision_num": "1083/3дп/15-25",
    "url": "https://hcj.gov.ua/doc/doc/52542",
    "judge_name": "Шулежко Віктор Петрович",
    "court": "Окружний адміністративний суд міста Києва",
    "chamber": "Третя",
    "art106_grounds": [
      "пп. «б» п.1 ч.1 ст.106"
    ],
    "qualification": {
      "complaint": "Скаржник вбачав ознаки проступків за підпунктами «а», «б» пункту 1 та пунктом 4 частини першої статті 106.",
      "dp": "Справу відкрито за підпунктами «а», «б» пункту 1, пунктом 4 ч.1 ст.106; палата констатувала допущене внаслідок недбалості неналежне мотивування ухвали про забезпечення позову (пп. «б» п.1 ч.1 ст.106).",
      "vrp": null
    },
    "conduct": {
      "complaint": "За скаргою Ратушного Р.Т. суддя ухвалою від 26 листопада 2020 року незаконно забезпечив позов ТОВ «Дайтона груп», зупинивши дію рішень Київради щодо парку «Протасів Яр», без належного обґрунтування та з виходом за межі підстав ст.150 КАС.",
      "dp": "Палата встановила, що суддя без умислу, проте внаслідок недбалості ухвалив рішення про забезпечення позову без належного мотивування співвідношення інтересів сторін у суспільно значущій справі.",
      "vrp": null
    },
    "sanction": {
      "dp": "Догана — з позбавленням права на отримання доплат до посадового окладу судді протягом одного місяця.",
      "vrp": null
    },
    "summary": {
      "essence": "Третя Дисциплінарна палата притягнула суддю Шулежка В.П. до дисциплінарної відповідальності за неналежне мотивування ухвали про забезпечення позову (пп. «б» п.1 ч.1 ст.106) та застосувала догану з позбавленням доплат на один місяць.",
      "facts": "За скаргою Ратушного Р.Т. палата розглянула ухвалу судді від 26 листопада 2020 року, якою задоволено заяву ТОВ «Дайтона груп» про забезпечення позову у справі № 160/8226/20 шляхом зупинення дії рішень Київської міської ради щодо парку «Протасів Яр». Суддя не навів у мотивувальній частині належного обґрунтування співвідношення інтересів позивача та інших заінтересованих осіб, зокрема територіальної громади. Умислу не встановлено, проступок допущено внаслідок недбалості; з огляду на суспільну вагу справи попередження визнано непропорційним.",
      "conclusions": [
        "Ухвала про забезпечення позову у суспільно значущій справі не була належно вмотивована.",
        "Проступок допущено внаслідок недбалості, без умислу.",
        "Зважаючи на суспільну вагу справи, попередження визнано непропорційним.",
        "Пропорційним заходом визнано догану з позбавленням доплат на один місяць."
      ]
    },
    "processed_at": "2026-06-07 15:49:37"
  },
  {
    "filename": "1111_26.05.2025",
    "date": "26.05.2025",
    "decision_num": "1111/1дп/15-25",
    "url": "https://hcj.gov.ua/doc/doc/52637",
    "judge_name": "Ратушняк Ігор Олександрович",
    "court": "Тиврівський районний суд Вінницької області",
    "chamber": "Перша",
    "art106_grounds": [
      "п.2 ч.1 ст.106"
    ],
    "qualification": {
      "complaint": "Обидві скарги — пункт 2 частини першої статті 106 (безпідставне затягування / невжиття заходів щодо розгляду справ та зволікання з виготовленням рішення).",
      "dp": "Пункт 2 частини першої статті 106 — безпідставне затягування розгляду справ № 145/1494/19 та № 145/579/20.",
      "vrp": null
    },
    "conduct": {
      "complaint": "За скаргами Шевчука Ф.А. та адвоката Куцого Р.А. суддя роками не розглядав справи (за шість років у справі № 145/1494/19 відбулося лише 4 засідання), зволікав з виготовленням рішення, а в іншій справі не вживав заходів до розгляду попри клопотання про письмове провадження.",
      "dp": "Палата встановила безпідставне затягування розгляду об'єднаних справ, допущене внаслідок недбалості.",
      "vrp": null
    },
    "sanction": {
      "dp": "Попередження.",
      "vrp": null
    },
    "summary": {
      "essence": "Перша Дисциплінарна палата притягнула суддю Ратушняка І.О. до дисциплінарної відповідальності за безпідставне затягування розгляду справ (п.2 ч.1 ст.106) та застосувала попередження.",
      "facts": "Об'єднано дві справи за скаргами Шевчука Ф.А. та адвоката Куцого Р.А. в інтересах Вихрист О.А. У справі № 145/1494/19 за шість років відбулося лише чотири засідання; у справі № 145/579/20 суддя не вживав заходів до розгляду попри клопотання про письмове провадження. Палата врахувала, що суддя засуджений ВАКС за ч.3 ст.368 КК (вирок оскаржується) та що Третя ДП рішенням № 897/3дп/15-25 уже застосувала до нього подання про звільнення. У цій справі проступок визнано вчиненим унаслідок недбалості й обрано попередження.",
      "conclusions": [
        "Багаторічне нерозглядання справ свідчить про безпідставне затягування за п.2 ч.1 ст.106.",
        "У цій справі проступок допущено внаслідок недбалості.",
        "Палата врахувала позитивну характеристику та значний стаж судді.",
        "Пропорційним проступку визнано попередження."
      ]
    },
    "processed_at": "2026-06-07 15:49:37"
  },
  {
    "filename": "1138_28.05.2025",
    "date": "28.05.2025",
    "decision_num": "1138/3дп/15-25",
    "url": "https://hcj.gov.ua/doc/doc/52821",
    "judge_name": "Дацюк Ольга Ігорівна",
    "court": "Шевченківський районний суд міста Запоріжжя",
    "chamber": "Третя",
    "art106_grounds": [
      "пп. «а» п.1 ч.1 ст.106",
      "п.4 ч.1 ст.106"
    ],
    "qualification": {
      "complaint": "Прокуратура вбачала підстави для дисциплінарної відповідальності у зв'язку з нерозглядом клопотань про продовження запобіжного заходу.",
      "dp": "Підпункт «а» пункту 1 та пункт 4 частини першої статті 106 — істотне (умисне) порушення норм процесуального права та грубе порушення закону, що призвело до істотних негативних наслідків.",
      "vrp": null
    },
    "conduct": {
      "complaint": "За скаргою Шевченківської окружної прокуратури суддя не розглянула клопотання прокурора про продовження запобіжного заходу обвинуваченому у справі № 336/1861/22 до закінчення його строку, унаслідок чого особу звільнено з-під варти.",
      "dp": "Палата встановила низку грубих процесуальних порушень під час розгляду кримінального провадження за обвинуваченням у особливо тяжкому злочині, через які сторона обвинувачення не змогла продовжити запобіжний захід; це призвело до звільнення обвинуваченого, його ухилення від суду та розшуку. Дії визнано умисними.",
      "vrp": null
    },
    "sanction": {
      "dp": "Догана — з позбавленням права на отримання доплат до посадового окладу судді протягом одного місяця.",
      "vrp": null
    },
    "summary": {
      "essence": "Третя Дисциплінарна палата притягнула суддю Дацюк О.І. до дисциплінарної відповідальності за грубі процесуальні порушення у кримінальному провадженні (пп. «а» п.1, п.4 ч.1 ст.106) та застосувала догану з позбавленням доплат на один місяць.",
      "facts": "За скаргою прокуратури палата встановила, що у справі № 336/1861/22 суддя не розглянула клопотання про продовження запобіжного заходу обвинуваченому в особливо тяжкому злочині до закінчення строку тримання під вартою, унаслідок чого особу звільнено з-під варти; згодом обвинувачений ухилявся від суду й перебував у розшуку. Палата визнала дії умисними, однак, урахувавши високе навантаження, позитивну характеристику та відсутність невідворотних наслідків, обрала догану з позбавленням доплат на один місяць.",
      "conclusions": [
        "Нерозгляд клопотання про продовження запобіжного заходу призвів до звільнення обвинуваченого з-під варти.",
        "Допущені порушення кваліфіковано за пп. «а» п.1 та п.4 ч.1 ст.106.",
        "Дії судді визнано умисними.",
        "З урахуванням навантаження та характеристики обрано догану з позбавленням доплат на один місяць."
      ]
    },
    "processed_at": "2026-06-07 15:49:37"
  },
  {
    "filename": "1202_04.06.2025",
    "date": "04.06.2025",
    "decision_num": "1202/3дп/15-25",
    "url": "https://hcj.gov.ua/doc/doc/53033",
    "judge_name": "Тютюн Тетяна Миколаївна",
    "court": "Київський апеляційний суд",
    "chamber": "Третя",
    "art106_grounds": [
      "п.2 ч.1 ст.106"
    ],
    "qualification": {
      "complaint": "Скаржниця вбачала проступок у тривалому невирішенні питання про відкриття апеляційного провадження.",
      "dp": "Пункт 2 частини першої статті 106 — невжиття суддею заходів щодо розгляду справи протягом установленого законом строку.",
      "vrp": null
    },
    "conduct": {
      "complaint": "За скаргою Ведутенко О.І. суддя-доповідач понад два роки не вирішувала питання про відкриття апеляційного провадження у кримінальній справі № 761/3894/15-к, чим створила ризики невиконання вироку та порушення прав потерпілої.",
      "dp": "Палата встановила істотне порушення строків вирішення питання про відкриття апеляційного провадження (понад два роки), допущене внаслідок недбалості; складність справи й завантаженість суду не виправдовують такої тривалості.",
      "vrp": null
    },
    "sanction": {
      "dp": "Попередження.",
      "vrp": null
    },
    "summary": {
      "essence": "Третя Дисциплінарна палата притягнула суддю Тютюн Т.М. до дисциплінарної відповідальності за невжиття заходів щодо своєчасного розгляду справи (п.2 ч.1 ст.106) та застосувала попередження.",
      "facts": "За скаргою Ведутенко О.І. палата встановила, що у кримінальній справі № 761/3894/15-к суддя-доповідач Київського апеляційного суду понад два роки (з січня 2023 року) не вирішувала питання про відкриття апеляційного провадження; провадження відкрито лише у січні 2025 року. Палата зазначила, що складність справи та завантаженість суду не виправдовують такої тривалості, а вина судді характеризується недбалістю, та обрала попередження.",
      "conclusions": [
        "Тривалість вирішення питання про відкриття апеляційного провадження понад два роки є істотним порушенням строків.",
        "Складність справи й завантаженість суду не виправдовують такої тривалості.",
        "Вина судді характеризується недбалістю.",
        "Пропорційним проступку визнано попередження."
      ]
    },
    "processed_at": "2026-06-07 15:49:37"
  },
  {
    "filename": "1240_11.06.2025",
    "date": "11.06.2025",
    "decision_num": "1240/2дп/15-25",
    "url": "https://hcj.gov.ua/doc/doc/53153",
    "judge_name": "Соколов Олексій Михайлович",
    "court": "Печерський районний суд міста Києва",
    "chamber": "Друга",
    "art106_grounds": [
      "пп. «а» п.1 ч.1 ст.106",
      "пп. «в» п.1 ч.1 ст.106",
      "п.2 ч.1 ст.106",
      "п.3 ч.1 ст.106"
    ],
    "qualification": {
      "complaint": "Скаржник вбачав безпідставне затягування розгляду справи та ухилення від правосуддя.",
      "dp": "Підпункти «а», «в» пункту 1 та пункти 2, 3 частини першої статті 106 — істотне порушення процесуального права, порушення гласності, затягування розгляду та поведінка, що підриває авторитет правосуддя.",
      "vrp": null
    },
    "conduct": {
      "complaint": "За скаргою адвоката Боровського Т.М. в інтересах Годунової Н.І. суддя розглядав справу майже п'ять років, призначаючи засідання раз на 3–4 місяці й на дні своєї відпустки, не забезпечував фіксування засідань і не вживав заходів за задоволеним клопотанням про витребування доказів.",
      "dp": "Палата встановила умисні дії судді: неодноразове безпідставне створення перешкод у розгляді заяв і клопотань, ухилення від здійснення правосуддя протягом майже п'яти років, нездійснення фіксування процесу, що призвело до втрати особою права на судовий захист.",
      "vrp": null
    },
    "sanction": {
      "dp": "Сувора догана — з позбавленням права на отримання доплат до посадового окладу судді протягом трьох місяців.",
      "vrp": null
    },
    "summary": {
      "essence": "Друга Дисциплінарна палата притягнула суддю Соколова О.М. до дисциплінарної відповідальності за умисне затягування й ухилення від розгляду справи та порушення засад процесу (пп. «а», «в» п.1, п.2, п.3 ч.1 ст.106) і застосувала сувору догану з позбавленням доплат на три місяці.",
      "facts": "За скаргою адвоката в інтересах Годунової Н.І. палата встановила, що цивільну справу № 757/14959/20-ц суддя розглядав майже п'ять років, призначав засідання раз на 3–4 місяці та на дні відпустки, не забезпечував фіксування засідань і не реалізовував задоволене клопотання про витребування доказів. Дії визнано умисними; вони призвели до втрати особою можливості судового захисту. Палата визнала недоцільними більш суворі стягнення та обрала сувору догану з позбавленням доплат на три місяці.",
      "conclusions": [
        "Розгляд справи майже п'ять років із засіданнями на дні відпустки судді свідчить про умисне ухилення від правосуддя.",
        "Нездійснення фіксування процесу й невиконання власних ухвал порушує засади судочинства.",
        "Бездіяльність призвела до втрати особою права на судовий захист.",
        "Пропорційним визнано сувору догану з позбавленням доплат на три місяці."
      ]
    },
    "processed_at": "2026-06-07 15:49:37"
  },
  {
    "filename": "1503_16.07.2025",
    "date": "16.07.2025",
    "decision_num": "1503/3дп/15-25",
    "url": "https://hcj.gov.ua/doc/doc/53572",
    "judge_name": "Хомик Ірина Іванівна",
    "court": "Великоолександрівський районний суд Херсонської області",
    "chamber": "Третя",
    "art106_grounds": [
      "пп. «а» п.1 ч.1 ст.106"
    ],
    "qualification": {
      "complaint": "Скаргу подано щодо систематичного безпідставного звільнення осіб від адміністративної відповідальності за ст.130 КУпАП.",
      "dp": "Істотне порушення норм права під час здійснення правосуддя у справах про адміністративні правопорушення за ст.130 КУпАП; вина — непрямий умисел.",
      "vrp": null
    },
    "conduct": {
      "complaint": "За скаргою Маселка Р.А. суддя ухвалювала низку однотипних, шаблонно мотивованих постанов, якими звільняла осіб від адміністративної відповідальності за керування у стані сп'яніння (ст.130 КУпАП) за малозначністю, обмежуючись посиланням на щире каяття.",
      "dp": "Палата встановила стійкий, повторюваний і тривалий патерн ухвалення однотипних шаблонних постанов про звільнення правопорушників від відповідальності; вина характеризується непрямим умислом.",
      "vrp": null
    },
    "sanction": {
      "dp": "Попередження.",
      "vrp": null
    },
    "summary": {
      "essence": "Третя Дисциплінарна палата притягнула суддю Хомик І.І. до дисциплінарної відповідальності за систематичне неналежне вирішення справ про адміністративні правопорушення за ст.130 КУпАП та застосувала попередження.",
      "facts": "За скаргою Маселка Р.А. палата встановила, що суддя ухвалювала низку однотипних, незвично лаконічних і шаблонних постанов, якими звільняла осіб від адміністративної відповідальності за керування у стані сп'яніння (ст.130 КУпАП), посилаючись на малозначність та щире каяття. Множинність, повторюваність і тривалість такої поведінки дали палаті підстави визнати вину у формі непрямого умислу. Обрано попередження.",
      "conclusions": [
        "Ухвалення низки однотипних шаблонних постанов про звільнення від відповідальності за ст.130 КУпАП є дисциплінарним проступком.",
        "Стійкий і повторюваний патерн поведінки свідчить про непрямий умисел.",
        "За сукупністю факторів пропорційним визнано попередження."
      ]
    },
    "processed_at": "2026-06-07 15:49:37"
  },
  {
    "filename": "1560_23.07.2025",
    "date": "23.07.2025",
    "decision_num": "1560/3дп/15-25",
    "url": "https://hcj.gov.ua/doc/doc/53656",
    "judge_name": "Вінська Наталія Всеволодівна",
    "court": "Доброславський районний суд Одеської області (раніше — Комінтернівський)",
    "chamber": "Третя",
    "art106_grounds": [
      "п.2 ч.1 ст.106"
    ],
    "qualification": {
      "complaint": "Скаржник зазначав про безпідставне затягування розгляду справи та порушення права власності.",
      "dp": "Пункт 2 частини першої статті 106 — безпідставне затягування розгляду справи / невжиття заходів щодо розгляду заяви у строк.",
      "vrp": null
    },
    "conduct": {
      "complaint": "За скаргою Долгополова І.Р. (потерпілого у кримінальному провадженні щодо незаконного заволодіння його транспортним засобом) суддя безпідставно затягувала розгляд справи та не вживала заходів щодо розгляду заяви у встановлений законом строк.",
      "dp": "Палата встановила значне безпідставне затягування розгляду справи з грубої недбалості, що призвело до закінчення строку давності притягнення до кримінальної відповідальності, неможливості реалізації власником прав на майно та погіршення майнового стану.",
      "vrp": null
    },
    "sanction": {
      "dp": "Догана — з позбавленням права на отримання доплат до посадового окладу судді протягом одного місяця.",
      "vrp": null
    },
    "summary": {
      "essence": "Третя Дисциплінарна палата притягнула суддю Вінську Н.В. до дисциплінарної відповідальності за безпідставне затягування розгляду справи (п.2 ч.1 ст.106) та застосувала догану з позбавленням доплат на один місяць.",
      "facts": "За скаргою Долгополова І.Р. палата встановила, що суддя допустила значне безпідставне затягування розгляду справи та невжиття заходів щодо розгляду заяви у строк, чим порушила гарантоване ст.6 ЄКПЛ право на справедливий суд. Наслідками стали закінчення строку давності за ч.4 ст.358 КК, неможливість власника реалізувати права на транспортний засіб та погіршення його майнового стану. Вину визначено як грубу недбалість; обтяжувальна обставина — шкода особі в уразливому стані. Обрано догану з позбавленням доплат на один місяць.",
      "conclusions": [
        "Значне затягування розгляду справи порушило право на справедливий суд у розумні строки.",
        "Наслідком стало закінчення строку давності кримінального переслідування та шкода власнику майна.",
        "Вина судді характеризується грубою недбалістю.",
        "Пропорційним визнано догану з позбавленням доплат на один місяць."
      ]
    },
    "processed_at": "2026-06-07 15:49:37"
  },
