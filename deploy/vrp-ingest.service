[Unit]
Description=VRP nightly cycle (scrape HCJ acts, extract new ones, export, publish)
Documentation=file:/home/ubuntu/vrp-ai-sandbox/constitution/02_tech_stack.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/vrp-ai-sandbox
ExecStart=/home/ubuntu/vrp-ai-sandbox/code/run_daily.sh
# Converting a large backlog with LibreOffice + Docling is slow; the lock in
# run_daily.sh already prevents overlapping runs.
TimeoutStartSec=8h
# Ingest is background work — never let it starve an interactive session.
Nice=10
# The publish step pushes to GitHub over HTTPS and reads the token from
# ~/.git-credentials, so $HOME has to be the real one. systemd sets it from
# User=, but stating it means a change to that line cannot break the push
# silently.
Environment=HOME=/home/ubuntu
# ANTHROPIC_API_KEY is NOT set here on purpose: unit files under /etc are
# world-readable. run_daily.sh sources it from the repo's .env (mode 600).
